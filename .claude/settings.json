{
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bibi-ctrl on-stop"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bibi-ctrl status)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  }
}
