# Repo-globaler Laufzeit-State (DESIGN §3.2) — eine geteilte Kopie, nicht versioniert
.claude/.state.md

# Per-Maschine CC-Settings (Permissions, persönliche Prefs) — nicht versioniert.
# Die committete settings.json trägt die team-weiten Hooks + Safe-Baseline.
.claude/settings.local.json

# Obsidian-Workspace/-Config des Vaults (user-/maschinenspezifisch) — nicht ins Team-Repo.
vault/.obsidian/

# Obsidian-Papierkorb — gelöschte Notizen, analog zum bibi-v3-Muster nicht ins Repo.
vault/.trash/

# Runtime-State: SQLite, Worktrees, Job-Logs (Verzeichnis bleibt via .gitkeep sichtbar)
data/*
!data/.gitkeep

# Gesammelte/rohe Flat-File-Daten (News, Kurse …) — im Vault auf Platte, aber NICHT
# in git: wachsende/rotierende Rohdaten würden die History unbeschränkt aufblähen
# (DESIGN §3.5). Konvention: pro Case ein gitignorierter `data/`-Unterordner.
# Committet werden nur Code, Config und verdichtete Ergebnisse. Prüfen: `bibi-ctrl doctor`.
vault/case/*/data/

# Hinweis: ~/.config/bibi/env liegt AUSSERHALB des Repos (von `bibi-ctrl init`
# erzeugt) und wird hier nur dokumentiert — siehe INSTALL.md.

# Skills und Agents sind COMMITTED (Vendoring-Modell, DESIGN §3.3).
# library.yaml ist das Manifest; the-library ist nur für Install/Upgrade des
# Maintainers. Andere Entwickler erhalten alle Skills via git clone.

# Log-Dateien beliebiger Herkunft (z.B. Case-/Probe-Jobs) — nicht versioniert
*.log

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.DS_Store

# Personalisierte Signatur-Instanz (bibi3-Muster übernommen) — nur das Template ist
# committet, die ausgefüllte sign.md ist pro Nutzer/Knoten verschieden
# (CONVENTIONS.md § „==name:== annotations and the signature file").
vault/etc/templates/*
!vault/etc/templates/*.template.md
vault/etc/scratch/*
